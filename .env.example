# ── DCW Digital — Environment Variables ─────────────────────────────────────
# Copy this file to `.env.local` and fill in the values for local development.
# On Vercel, set these in Project Settings → Environment Variables.

# The canonical, public-facing URL of the site (no trailing slash).
# Used for metadata, canonical URLs, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL="https://dcw-digital.co.uk"

# Contact form delivery (Resend — https://resend.com). Optional in dev:
# when unset, the contact API logs submissions instead of sending email.
RESEND_API_KEY=""
CONTACT_TO_EMAIL="contact@dcw-digital.co.uk"
CONTACT_FROM_EMAIL="DCW Digital <noreply@dcw-digital.co.uk>"

# Discovery call booking link (Cal.com / Calendly). Used by "Book a Discovery Call".
NEXT_PUBLIC_BOOKING_URL="https://cal.com/danielcampbellwhite/discovery"

# Optional analytics (Plausible / Vercel Analytics). Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
